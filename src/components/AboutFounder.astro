---
import { Image } from "astro:assets";
import founderPhoto from "../assets/images/founder.png";
---

<section id="about" class="section-y bg-ink-2">
  <div class="page-wrap pad">
    <div class="grid items-start gap-12 lg:grid-cols-[1fr_1.1fr] lg:gap-20">

      <!-- Image -->
      <div class="relative">
        <Image
          src={founderPhoto}
          alt="Sumithra Sudhakar, Founder of Anandha Natyasthala"
          class="w-full object-cover aspect-[3/4] lg:aspect-[4/5]"
          widths={[400, 750]}
          sizes="(min-width: 1024px) 45vw, 100vw"
          format="webp"
          quality="mid"
          loading="lazy"
          decoding="async"
        />
        <div class="kolam-corner absolute -bottom-4 -right-4 hidden lg:block"></div>
      </div>

      <!-- Bio -->
      <div class="lg:pt-8">
        <p class="eyebrow mb-6">Founder & Principal Teacher</p>
        <h2 class="display text-[2.8rem] text-cream sm:text-[3.5rem] lg:text-[4.5rem]">
          Sumithra<br />Sudhakar
        </h2>

        <!-- Inline stats -->
        <dl class="mt-8 grid grid-cols-3 gap-4 border-y border-border py-6">
          <div>
            <dt class="display text-[2rem] text-gold">18+</dt>
            <dd class="eyebrow mt-1 text-muted">Years of<br/>training</dd>
          </div>
          <div>
            <dt class="display text-[2rem] text-gold">150+</dt>
            <dd class="eyebrow mt-1 text-muted">Professional<br/>engagements</dd>
          </div>
          <div>
            <dt class="display text-[2rem] text-gold">10+</dt>
            <dd class="eyebrow mt-1 text-muted">Natyanjali<br/>festivals</dd>
          </div>
        </dl>

        <div class="mt-7 space-y-4 text-sm leading-7 text-muted">
          <p>
            Bharatanatyam dancer trained for over eighteen years in the Vazhuvoor bani under <span class="text-cream">Kalai Choodamani Smt. Sasmitta K. Aroraa</span> of Shankkaram School of Art, in the lineage of S.K. Rajarathnam Pillai. Arangetram performed January 2018; currently Senior Faculty at Shankkaram Academy of Arts.
          </p>
          <p>
            Active performer across more than 150 professional engagements: national Natyanjali festivals including Chidambaram (44th edition) and Mayura Natyanjali, government cultural programmes, international platforms including Delhi, corporate events for SAP Labs and RMKV Silks, and ticketed productions at Medai, Coimbatore.
          </p>
          <p>
            Holder of a Diploma in Nattuvangam (2025), a Teacher's Training Certificate from Global Arts Academy UK (2024, Prayathnam Level 5 with excellence as Yathna Prathibha), and a B.Tech in Computer Science from Amrita Viswa Vidyapeetham (2023).
          </p>
          <p>
            Founder of Anandha Natyasthala, a school built on the belief that access to classical art should not depend on circumstance.
          </p>
        </div>

        <!-- Honour titles -->
        <div class="mt-8 flex flex-wrap gap-2">
          {["Natana Kala Mani 2024", "Natana Kala Shri 2020", "Nritya Vinodini 2019"].map(t => (
            <span class="border border-border px-3 py-1 text-xs text-muted">{t}</span>
          ))}
        </div>

        <div class="mt-8 flex flex-wrap gap-4">
          <a
            href="https://www.instagram.com/sumiithraa_sudhakar"
            target="_blank"
            rel="noopener noreferrer"
            class="btn-outline text-xs"
          >
            @sumiithraa_sudhakar
          </a>
          <a href="#contact" class="btn-gold text-xs">Get in touch</a>
        </div>
      </div>
    </div>
  </div>
</section>
