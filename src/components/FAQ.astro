---
const faqs = [
  {
    q: "Are classes suitable for all age groups?",
    a: "Yes, children, teenagers, adults, and senior students are all welcome. Classes are structured to match the pace and focus appropriate to each age group.",
  },
  {
    q: "Do I need prior dance experience?",
    a: "No prior experience is necessary. We welcome complete beginners and those with previous dance training alike.",
  },
  {
    q: "What equipment do I need for online classes?",
    a: "A device with a stable internet connection, comfortable clothing, a quiet space with enough room to move, and an open mind.",
  },
  {
    q: "Can I attend a trial class before enrolling?",
    a: "Yes. A trial class is available to help you experience the teaching style before committing to regular sessions.",
  },
  {
    q: "Can I cancel or reschedule a class?",
    a: "We try to accommodate rescheduling when possible. Please give advance notice and we will find a suitable slot.",
  },
];

const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  mainEntity: faqs.map(({ q, a }) => ({
    "@type": "Question",
    name: q,
    acceptedAnswer: { "@type": "Answer", text: a },
  })),
};
---

<script type="application/ld+json" set:html={JSON.stringify(faqSchema)} />

<section id="faq" class="section-y">
  <div class="page-wrap pad">
    <div class="grid gap-16 lg:grid-cols-[1fr_2fr] lg:gap-24">

      <!-- Left label -->
      <div>
        <p class="eyebrow mb-5">Questions</p>
        <h2 class="display text-[2.4rem] text-cream sm:text-[3rem]">Frequently<br />asked</h2>
        <p class="mt-5 text-sm leading-6 text-muted">
          Still have a question? <a href="#contact" class="text-gold hover:text-gold-2 transition-colors">Email us.</a>
        </p>
      </div>

      <!-- Accordion -->
      <div class="divide-y divide-border">
        {faqs.map(({ q, a }) => (
          <details class="group py-6">
            <summary class="flex cursor-pointer list-none items-start justify-between gap-6">
              <span class="text-[0.95rem] font-medium text-cream group-open:text-gold transition-colors">{q}</span>
              <span class="mt-0.5 shrink-0 text-muted transition-transform duration-300 group-open:rotate-45">
                <svg width="16" height="16" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.5">
                  <line x1="8" y1="2" x2="8" y2="14"/><line x1="2" y1="8" x2="14" y2="8"/>
                </svg>
              </span>
            </summary>
            <p class="mt-4 text-sm leading-7 text-muted">{a}</p>
          </details>
        ))}
      </div>

    </div>
  </div>
</section>
