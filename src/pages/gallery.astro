  { file: "bekal-5.jpg", alt: "Sumithra Sudhakar — Vaishakha Natanam 2026, Bekal", caption: "Vaishakha Natanam 2026 · Bekal, Kerala" },
  // Kannada Rajyotsava
  { file: "kr2023-solo.jpg", alt: "Sumithra Sudhakar — Kannada Rajyotsava 2023 solo performance", caption: "SAP Karnataka Rajyothsava 2023" },
  { file: "kr2025-abhinaya-1.jpg", alt: "Sumithra Sudhakar — abhinaya, Kannada Rajyotsava 2025", caption: "SAP Karnataka Rajyothsava 2025 · Thematic presentation" },
  { file: "kr2025-invocatory.jpg", alt: "Sumithra Sudhakar — invocatory dance, Kannada Rajyotsava 2025", caption: "SAP Karnataka Rajyothsava 2025 · Invocatory performance" },
  { file: "kr2025-solo.jpg", alt: "Sumithra Sudhakar — solo on stage, Kannada Rajyotsava 2025", caption: "SAP Karnataka Rajyothsava 2025" },
