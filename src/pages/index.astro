---
import BaseLayout from "../layouts/BaseLayout.astro";
import Header from "../components/Header.astro";
import Hero from "../components/Hero.astro";
import IntroBlocks from "../components/IntroBlocks.astro";
import DanceStyle from "../components/DanceStyle.astro";
import AboutFounder from "../components/AboutFounder.astro";
import FAQ from "../components/FAQ.astro";
import RegisterInterest from "../components/RegisterInterest.astro";
import ContactSection from "../components/ContactSection.astro";
import Footer from "../components/Footer.astro";
---

<BaseLayout
  title="Anandha Natyasthala — Online Bharatanatyam Classes via Zoom"
  description="Online Bharatanatyam classes via Zoom with Indian classical dance teacher Sumithra Sudhakar, Vazhuvoor bani. For children and adults of all levels, in India and abroad."
>
  <Header />
  <main>
    <Hero />
    <IntroBlocks />
    <DanceStyle />
    <AboutFounder />
    <FAQ />
    <div class="kolam-rule"></div>
    <RegisterInterest />
    <div class="kolam-rule-dark"></div>
    <ContactSection />
  </main>
  <Footer />
</BaseLayout>
